#!/bin/bash
SERVER_PATH=/tmp/nvim-remote-server
CURRENT_DIR=$(cat /tmp/current-dir)

# Parse the file argument to extract file path, line number, and column number
arg="$1"
file_path=""
line_num=""
col_num=""

# Check if the argument contains line info (contains colon)
if [[ "$arg" == *:* ]]; then
  # Split by first colon to get file and rest
  file_path="${arg%%:*}"
  rest="${arg#*:}"

  # Check if there's a column number (second colon)
  if [[ "$rest" == *:* ]]; then
    line_num="${rest%%:*}"
    col_num="${rest#*:}"
    # Remove any additional parts after column
    col_num="${col_num%%:*}"
  else
    line_num="$rest"
  fi
else
  file_path="$arg"
fi

# Determine final file path
if [[ "$file_path" == /* ]]; then
  # Absolute path - use as is
  final_path="$file_path"
else
  # Relative path - prepend current directory
  final_path="$CURRENT_DIR/$file_path"
fi

# Return file path with line number if present
if [[ -n "$line_num" ]]; then
  echo "+$line_num" "$final_path"
else
  echo "$final_path"
fi

if [ -e $SERVER_PATH ]; then
  # If server exists then send file open command to it
  nvim --server $SERVER_PATH --remote $final_path

  # Build the positioning command
  if [[ -n "$line_num" && -n "$col_num" ]]; then
    nvim --server $SERVER_PATH --remote-send "<A-k><A-l>:$line_num<CR>${col_num}|"
  elif [[ -n "$line_num" ]]; then
    nvim --server $SERVER_PATH --remote-send "<A-k><A-l>:$line_num<CR>"
  fi
else
  # Otherwise open nvim in a new window
  REAL_NVIM=$(which nvim)

  # Build the startup command with positioning
  if [[ -n "$line_num" && -n "$col_num" ]]; then
    startup_cmd="$REAL_NVIM --listen $SERVER_PATH $final_path +$line_num -c 'normal ${col_num}|'"
  elif [[ -n "$line_num" ]]; then
    startup_cmd="$REAL_NVIM --listen $SERVER_PATH $final_path +$line_num"
  else
    startup_cmd="$REAL_NVIM --listen $SERVER_PATH $final_path"
  fi

  alacritty -e fish -c "$startup_cmd"
  echo "$startup_cmd" >/tmp/result-new
fi
