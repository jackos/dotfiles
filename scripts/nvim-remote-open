#!/bin/bash
SERVER_PATH=/tmp/nvim-remote-server
CURRENT_DIR=$(cat /tmp/current-dir)

# Parse the file argument to extract file path and line number
arg="$1"
file_path=""
line_num=""

# Check if the argument contains line info (contains colon)
if [[ "$arg" == *:* ]]; then
  # Split by first colon to get file and line
  file_path="${arg%%:*}"
  line_num="${arg#*:}"
  # Remove any additional colon-separated parts (like column number)
  line_num="${line_num%%:*}"
else
  file_path="$arg"
fi

# Determine final file path
if [[ "$file_path" == /* ]]; then
  # Absolute path - use as is
  final_path="$file_path"
else
  # Relative path - prepend current directory
  final_path="$CURRENT_DIR/$file_path"
fi

# Return file path with line number if present
if [[ -n "$line_num" ]]; then
  echo "+$line_num" "$final_path"
else
  echo "$final_path"
fi

if [ -e $SERVER_PATH ]; then
  # If server exists then send file open command to it
  nvim --server $SERVER_PATH --remote $final_path
  nvim --server $SERVER_PATH --remote-send "<A-k><A-l>:$line_num<CR>"
else
  # Otherwise open nvim in a new window
  REAL_NVIM=$(which nvim)
  alacritty -e fish -c "$REAL_NVIM --listen $SERVER_PATH $final_path +$line_num"
  echo "$REAL_NVIM --listen $SERVER_PATH $final_path +$line_num" >/tmp/result-new
fi
