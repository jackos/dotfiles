// Zed settings
//
// documentation: https://zed.dev/docs/configuring-zed
{
    "agent": {
        "always_allow_tool_actions": true,
        "default_model": {
            "provider": "zed.dev",
            "model": "claude-sonnet-4-5-thinking"
        },
        "model_parameters": [ ]
    },
    "format_on_save": "off",
    "terminal": {
        "font_size": 11.0,
        "shell": { "program": "/usr/bin/fish" },
        "env": {
            "MODULAR_DERIVED_PATH": "/home/jack/src/modular/.derived"
        }
        // "font_family": "Hack Nerd Font"
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },
    "tab_bar": {
        "show": true
    },
    "gutter": {
        "line_numbers": true
    },
    "minimap": {
        "show": "never"
    },
    "cursor_shape": "bar",
    "cursor_blink": false,
    "show_whitespaces": "all",
    "show_edit_predictions": true,
    "remove_trailing_whitespace_on_save": true,
    "soft_wrap": "editor_width",
    "hard_tabs": false,
    "tab_size": 4,
    "ui_font_size": 16,
    "buffer_font_size": 13.0,
    "vim_mode": true,
    "base_keymap": "VSCode",
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Tokyo Night"
    },
    "enable_language_server": true,
    "languages": {
        "Mojo": {
            "enable_language_server": true,
            "language_servers": [ "mojo-lsp-server" ]
        }
    },
    "inlay_hints": {
        "enabled": true
    },
}
