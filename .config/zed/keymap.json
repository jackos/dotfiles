// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    {
        "context": "Editor"
    },
    {
        "bindings": {
            "ctrl-s": "workspace::Save",
            "ctrl-shift-p": "command_palette::Toggle",
            "ctrl-p": "file_finder::Toggle",
            "ctrl-h": "pane::ActivatePreviousItem",
            "ctrl-l": "pane::ActivateNextItem",
            "alt-t": "terminal_panel::ToggleFocus",
            "alt-e": "project_panel::ToggleFocus",
            "alt-k": "workspace::ActivatePaneUp",
            "alt-j": "workspace::ActivatePaneDown",
            "alt-l": "workspace::ActivatePaneRight",
            "alt-h": "workspace::ActivatePaneLeft",
            "alt-shift-l": "pane::SplitRight",
            "alt-shift-j": "pane::SplitDown",
            "ctrl-w": "pane::CloseActiveItem",
            "alt-w": "pane::CloseActiveItem",
            "alt-c": "agent::ToggleFocus",
            "alt-f": "workspace::ToggleZoom",
            "ctrl-shift-m": "editor::SelectNext",
            "ctrl-alt-shift-m": "editor::SelectAllMatches",
            "shift-u": "vim::Redo"
        }
    }
]
