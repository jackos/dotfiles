set default-bg "#292d3e"
set default-fg "#959dcb"
set font "hack 10"

set statusbar-bg "#404c51"
set statusbar-fg "#959dcb"
set statusbar-basename true

set inputbar-bg "#292d3e"
set inputbar-fg "#959dcb"

set index-bg "#292d3e"
set index-fg "#959dcb"
set index-active-bg "#a7c080"
set index-active-fg "#2b3339"

set completion-bg "#292d3e"
set completion-fg "#959dcb"
set completion-group-bg "#292d3e"
set completion-group-fg "#7fbbb3"
set completion-highlight-bg "#a7c080"
set completion-highlight-fg "#2b3339"

set notification-bg "#292d3e"
set notification-fg "#959dcb"
set notification-error-bg "#e68183"
set notification-error-fg "#2b3339"
set notification-warning-bg "#e68183"
set notification-warning-fg "#2b3339"

set highlight-color "#a7c080"
set highlight-active-color "#7fbbb3"
set highlight-transparency 0.35
map <A-n> set nohlsearch

set recolor-lightcolor "#292d3e"
set recolor-darkcolor "#959dcb"
set recolor-keephue "true"
set recolor "true"

set render-loading-bg "#292d3e"
set render-loading-fg "#959dcb"

set selection-clipboard clipboard
set window-title-home-tilde true

set selection-clipboard clipboard
